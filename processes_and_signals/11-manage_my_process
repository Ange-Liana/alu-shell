#!/usr/bin/env bash
# Init script to start, stop, or restart manage_my_process

PIDFILE="/var/run/my_process.pid"
SCRIPT="$(pwd)/manage_my_process"

case "$1" in
  start)
    nohup "$SCRIPT" >/dev/null 2>&1 &  # Ensure it runs detached
    echo $! > "$PIDFILE"               # Save the PID
    echo "manage_my_process started"
    ;;
  stop)
    if [ -f "$PIDFILE" ]; then
      kill "$(cat "$PIDFILE")"         # Stop the process
      rm -f "$PIDFILE"                 # Delete PID file
    fi
    echo "manage_my_process stopped"
    ;;
  restart)
    if [ -f "$PIDFILE" ]; then
      kill "$(cat "$PIDFILE")"
      rm -f "$PIDFILE"
    fi
    nohup "$SCRIPT" >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
    echo "manage_my_process restarted"
    ;;
  *)
    echo "Usage: manage_my_process {start|stop|restart}"
    ;;
esac



