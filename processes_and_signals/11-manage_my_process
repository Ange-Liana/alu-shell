#!/usr/bin/env bash
# Init script to start, stop, or restart manage_my_process

PIDFILE="/var/run/my_process.pid"
SCRIPT="./manage_my_process"

case "$1" in
  start)
    # Start the process in the background and save its PID
    $SCRIPT &
    echo $! > "$PIDFILE"
    echo "manage_my_process started"
    ;;
  stop)
    # Stop the process using the PID and remove the PID file
    if [ -f "$PIDFILE" ]; then
      kill "$(cat "$PIDFILE")"
      rm -f "$PIDFILE"
    fi
    echo "manage_my_process stopped"
    ;;
  restart)
    # Stop and start again
    if [ -f "$PIDFILE" ]; then
      kill "$(cat "$PIDFILE")"
      rm -f "$PIDFILE"
    fi
    $SCRIPT &
    echo $! > "$PIDFILE"
    echo "manage_my_process restarted"
    ;;
  *)
    echo "Usage: manage_my_process {start|stop|restart}"
    ;;
esac


