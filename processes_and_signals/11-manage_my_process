#!/usr/bin/env bash
# Init script to start, stop, or restart manage_my_process

PIDFILE="/var/run/my_process.pid"
SCRIPT="$(pwd)/manage_my_process"  # Absolute path ensures it runs correctly

case "$1" in
  start)
    $SCRIPT &                # Run in background
    echo $! > "$PIDFILE"     # Save PID
    echo "manage_my_process started"
    ;;
  stop)
    if [ -f "$PIDFILE" ]; then
      kill "$(cat "$PIDFILE")"   # Kill the process
      rm -f "$PIDFILE"           # Delete PID file
    fi
    echo "manage_my_process stopped"
    ;;
  restart)
    if [ -f "$PIDFILE" ]; then
      kill "$(cat "$PIDFILE")"
      rm -f "$PIDFILE"
    fi
    $SCRIPT &
    echo $! > "$PIDFILE"
    echo "manage_my_process restarted"
    ;;
  *)
    echo "Usage: manage_my_process {start|stop|restart}"
    ;;
esac



